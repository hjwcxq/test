# 服务监听端口（容器内固定 8080，一般无需修改）
PORT=8080

# 外部基础路径。反向代理去除 /apps/p1/ 前缀时，若代理未发送 X-Forwarded-Prefix，
# 可显式设置此变量，让前端拼装出带前缀的 API 地址。
# APP_BASE_PATH=/apps/p1

# 应用版本无需环境变量：唯一依据是仓库根目录 .delivery-release.json，
# 其中 version 必须与 package.json 的 version 一致。页面与 /version.json
# 直接读取这份发布记录；不读取交付中心注入的版本，也不用容器启动时间。
# 发布新版本：npm run release -- 1.2.0（同步版本号与发布时间）。

# 可选：LLM 增强通道。未配置时自动使用本地结构化启发式引擎，完全离线可用。
# LLM_API_KEY=
# LLM_API_URL=https://api.openai.com/v1/chat/completions
# LLM_MODEL=gpt-4o-mini
