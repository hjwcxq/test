# 服务监听端口（容器内固定 8080，一般无需修改）
PORT=8080

# 外部基础路径。反向代理去除 /apps/p1/ 前缀时，若代理未发送 X-Forwarded-Prefix，
# 可显式设置此变量，让前端拼装出带前缀的 API 地址。
# APP_BASE_PATH=/apps/p1

# 当前交付版本与交付时间必须成对注入，页面右上角与 GET /health 会展示这一条交付记录；
# 未注入时依次取构建产物 dist/version.json、仓库根目录 delivery.json（单一来源）。
# APP_VERSION=12
# APP_DELIVERY_TIME=2026-11-19 10:34

# 可选：LLM 增强通道。未配置时自动使用本地结构化启发式引擎，完全离线可用。
# LLM_API_KEY=
# LLM_API_URL=https://api.openai.com/v1/chat/completions
# LLM_MODEL=gpt-4o-mini
