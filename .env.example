# 服务监听端口（容器内固定 8080，一般无需修改）
PORT=8080

# 外部基础路径。反向代理去除 /apps/p1/ 前缀时，若代理未发送 X-Forwarded-Prefix，
# 可显式设置此变量，让前端拼装出带前缀的 API 地址。
# APP_BASE_PATH=/apps/p1

# 当前交付版本与交付时间必须成对注入，页面右上角、GET /health 与 GET /version 展示同一条交付记录。
# 优先级：环境变量 > 部署挂载记录文件 > 构建产物 dist/version.json > 仓库根目录 delivery.json。
# 每次交付在部署阶段更新注入值或挂载文件即可，页面刷新后自动跟随，不会停留在上一版。
# APP_VERSION=13
# APP_DELIVERY_TIME=2026-11-19 10:45
# 可选：部署时挂载的交付记录文件（JSON：{"version":"v14","deliveredAt":"2026-11-20 09:10"}）。
# 将记录挂载到镜像内并设置此变量，优先级高于构建产物；替换文件后刷新即可跟随新版本。
# APP_DELIVERY_FILE=/run/delivery/delivery.json

# 可选：LLM 增强通道。未配置时自动使用本地结构化启发式引擎，完全离线可用。
# LLM_API_KEY=
# LLM_API_URL=https://api.openai.com/v1/chat/completions
# LLM_MODEL=gpt-4o-mini
