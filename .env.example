# 服务监听端口（容器内固定 8080，一般无需修改）
PORT=8080

# 外部基础路径。反向代理去除 /apps/p1/ 前缀时，若代理未发送 X-Forwarded-Prefix，
# 可显式设置此变量，让前端拼装出带前缀的 API 地址。
# APP_BASE_PATH=/apps/p1

# 版本号无需手工填写：npm run build 前会自动执行 scripts/delivery-index.mjs，
# 依据「实现交付任务 #N」的交付历史计算当前版本并写入 delivery.json。
# 页面打开后读取 /version.json，展示当前实际运行实例的版本；
# 交付时间取容器首次启动时刻（UTC，精确到分钟），也可由部署平台注入。
#
# 以下变量仅用于部署平台在运行/构建时覆盖自动解析结果（可选）：
# APP_VERSION=v15
# APP_DELIVERY_TIME=2026-11-20 09:30
# APP_STARTED_AT=2026-11-20 09:30
#
# 可选：部署时挂载的交付记录文件（JSON：{"version":"v15","deliveredAt":"2026-11-20 09:30"}）。
# 将记录挂载到镜像内并设置此变量，优先级高于构建产物；替换文件后刷新即可跟随新版本。
# APP_DELIVERY_FILE=/run/delivery/delivery.json

# 可选：LLM 增强通道。未配置时自动使用本地结构化启发式引擎，完全离线可用。
# LLM_API_KEY=
# LLM_API_URL=https://api.openai.com/v1/chat/completions
# LLM_MODEL=gpt-4o-mini
